<?xml version="1.0"?>
<launch>
    <arg name="ns1" default="ego"/>
    <arg name="loop_rate_hz" default="100.0"/>
    <!-- manual:=false (default): autonomous driving with perception (COMP-01) and control (COMP-02).
         manual:=true: the provided autonomous_driving node passes /manual_input through (manual_driving.launch.xml). -->
    <arg name="manual" default="false"/>

    <group unless="$(var manual)">
        <node pkg="autonomous_driving" exec="perception" name="perception" namespace="$(var ns1)" output="screen">
            <param name="perception/ns" value="$(var ns1)"/>
            <param name="perception/loop_rate_hz" value="$(var loop_rate_hz)"/>
        </node>
        <node pkg="autonomous_driving" exec="control" name="control" namespace="$(var ns1)" output="screen">
            <param name="control/ns" value="$(var ns1)"/>
            <param name="control/loop_rate_hz" value="$(var loop_rate_hz)"/>
            <param name="control/target_speed" value="10.0"/>
        </node>
    </group>

    <group if="$(var manual)">
        <node pkg="autonomous_driving" exec="autonomous_driving" name="autonomous_driving" namespace="$(var ns1)" output="screen">
            <param name="autonomous_driving/ns" value="$(var ns1)"/>
            <param name="autonomous_driving/loop_rate_hz" value="$(var loop_rate_hz)"/>
            <param name="autonomous_driving/use_manual_inputs" value="true"/>
        </node>
    </group>
</launch>
